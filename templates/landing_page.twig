{% extends "base.twig" %}

{% block title %}Welcome to TicketApp
{% endblock %}

{% block content %}
	{# HERO SECTION - Fixed Height, Blue Background, Content and Wave Layering #}
	{# The outer div should be full width to ensure the blue background spans edge-to-edge. #}
		<div class="w-full relative overflow-hidden h-[500px] bg-primary-blue"> <div class="max-w-1440 mx-auto relative z-20 pt-24 sm:pt-32 px-4 text-center">
			<h1 class="text-white text-5xl font-extrabold mb-4">
				Welcome to TicketApp
			</h1>
			<p class="text-white text-lg mb-10 max-w-lg mx-auto">
				Your one-stop solution for managing support tickets efficiently.
			</p>

			<div class="flex justify-center space-x-4">
				<a href="/signup" class="bg-white text-primary-blue hover:bg-gray-100 font-bold py-3 px-8 rounded-lg shadow-lg transition duration-150">
					Get Started
				</a>
				<a href="/login" class="bg-transparent border-2 border-white text-white hover:bg-white/10 font-bold py-3 px-8 rounded-lg transition duration-150">
					Login
				</a>
			</div>
		</div>

		{# Wave Background Layer: Positioned absolutely at the bottom (z-10) #}
		<div
			class="absolute inset-x-0 bottom-0 z-10">
			{# Ensure this path is correct based on your file structure #}
			<img src="public/assets/wave.svg" alt="Wavy Background" class="w-full h-auto block"/>
		</div>
	</div>

	{# FEATURES SECTION: This section *should* be constrained, so we keep the max-width here. #}
	<section class="max-w-1440 mx-auto py-16 px-4">
		<h2 class="text-3xl font-bold text-center text-gray-800 mb-12">Features</h2>

		<div
			class="grid grid-cols-1 md:grid-cols-3 gap-8">
			{# Feature Card 1: Track Everything #}
			<div class="bg-white p-6 rounded-xl shadow lg:hover:shadow-xl transition duration-300">
				<h3 class="text-xl font-semibold text-primary-blue mb-2">Track Everything</h3>
				<p class="text-gray-600">Keep a clear view of all open, in-progress, and resolved tickets.</p>
			</div>

			{# Feature Card 2: Collaborate #}
			<div class="bg-white p-6 rounded-xl shadow lg:hover:shadow-xl transition duration-300">
				<h3 class="text-xl font-semibold text-primary-blue mb-2">Collaborate</h3>
				<p class="text-gray-600">Work with your team to solve customer issues faster.</p>
			</div>

			{# Feature Card 3: Stay Organized #}
			<div class="bg-white p-6 rounded-xl shadow lg:hover:shadow-xl transition duration-300">
				<h3 class="text-xl font-semibold text-primary-blue mb-2">Stay Organized</h3>
				<p class="text-gray-600">Easy-to-use interface to create, update, and manage your workflow.</p>
			</div>
		</div>
	</section>
{% endblock %}
