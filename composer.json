{
    "name": "hng-tickets/twig-project",
    "description": "Multi-Framework Ticket App - Twig Implementation",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.0",
        "twig/twig": "^3.21"
    },
    "require-dev": {
        "symfony/var-dumper": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
